{
  "manifest_version": 3,
  "name": "QR WB — Цифровой",
  "version": "0.7.0",
  "description": "Сбор QR WB Цифрового по расписанию и передача в ежедневный отчёт возвратов.",
  "permissions": [
    "activeTab",
    "scripting",
    "alarms",
    "storage"
  ],
  "action": {
    "default_title": "Сохранить экран QR WB",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src https://bi.metaverseworld.ru"
  },
  "host_permissions": [
    "https://www.wildberries.ru/*",
    "https://wildberries.ru/*",
    "https://bi.metaverseworld.ru/api/returns/wb-qr/tsifrovoy"
  ],
  "background": {
    "service_worker": "background.js"
  }
}