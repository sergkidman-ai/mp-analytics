[Unit]
Description=WB acc1 missing color and component groups with verified recovery
After=network-online.target mkt-wb-glue-bundles.service
Wants=network-online.target
StartLimitIntervalSec=1800
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/opt/mp-analytics
ExecStart=/opt/mp-analytics/venv/bin/python -u -m ops.wb_glue_supervisor --kind core --recovery-attempts 3
StandardOutput=append:/opt/mp-analytics/docs/reports/mkt_wb_core_glue_2026-10-10_acc1/worker.log
StandardError=append:/opt/mp-analytics/docs/reports/mkt_wb_core_glue_2026-10-10_acc1/worker.log
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=78
User=root

[Install]
WantedBy=multi-user.target
