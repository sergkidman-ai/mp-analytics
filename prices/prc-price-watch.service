[Unit]
Description=Прайсы поставщиков: новое письмо -> оприходование в МойСклад (поток prc)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
# Загрузка идёт ТОЛЬКО когда в почте появилось письмо свежее уже обработанного —
# решение принимает сам сторож, таймер лишь будит его (см. ops/prc_price_watch.py).
ExecStart=/opt/mp-analytics/venv/bin/python -m ops.prc_price_watch --supplier kaktus_msk
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal
