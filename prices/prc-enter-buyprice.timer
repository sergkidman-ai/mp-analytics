[Unit]
Description=Закупочная из оприходований: раз в сутки ночью (поток prc)

[Timer]
# Часы сервера — UTC (systemd 249 не понимает таймзону в OnCalendar).
# Внешний API-загрузчик пересоздаёт документы ~02, 07, 16, 21 ч МСК (аудит МС 11–14.09.2026).
# 20:05 UTC = 23:05 МСК: берём вечернюю загрузку, окно записи 23:00–05:00 открыто,
# и полный первый прогон (~3 ч) успевает до ночной перезагрузки в 02 ч.
# Persistent=false: пропущенный запуск днём не нужен — писать вне окна скрипт всё равно откажется.
OnCalendar=*-*-* 20:05:00
RandomizedDelaySec=2min
Persistent=false
Unit=prc-enter-buyprice.service

[Install]
WantedBy=timers.target
