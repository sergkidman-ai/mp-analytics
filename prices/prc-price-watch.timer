[Unit]
Description=Сторож прайсов поставщиков: проверять почту каждые полчаса (поток prc)

[Timer]
# Часы сервера — UTC (systemd 249 не понимает таймзону в OnCalendar).
# 04:09..18:39 UTC = 07:09..21:39 МСК: прайс Кактуса приходит днём (10.08 — в 11:23 МСК),
# ночью проверять нечего. Минуты не круглые — чтобы не толпиться с чужими таймерами.
OnCalendar=*-*-* 04..18:09,39:00
RandomizedDelaySec=3min
# Persistent: сервер перезагрузили в обед — сторож проверит почту сразу, а не через полчаса.
Persistent=true
Unit=prc-price-watch.service

[Install]
WantedBy=timers.target
