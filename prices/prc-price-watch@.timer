[Unit]
Description=Сторож прайсов (%i): проверять почту каждые полчаса (поток prc)

[Timer]
# Часы сервера — UTC (systemd 249 не понимает таймзону в OnCalendar).
# 04:09..18:39 UTC = 07:09..21:39 МСК: прайсы приходят днём (12.08 — Одиссей 09:44,
# Колортек 10:19, Кактус 10:53 МСК), ночью проверять нечего.
# Минуты не круглые — чтобы не толпиться с чужими таймерами.
OnCalendar=*-*-* 04..18:09,39:00
# Разброс больше, чем был у одиночного сторожа (3 мин): инстансов теперь несколько, и без
# разброса все поставщики полезли бы в почту и в МойСклад одной секундой.
RandomizedDelaySec=5min
# Persistent: сервер перезагрузили в обед — сторож проверит почту сразу, а не через полчаса.
Persistent=true
Unit=prc-price-watch@%i.service

[Install]
WantedBy=timers.target
