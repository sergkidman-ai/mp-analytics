{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "defaultMode": "acceptEdits",

    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(//root/.claude/.credentials.json)",
      "Read(//root/.claude/.credentials.json.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./secrets/**)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./secrets/**)",

      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git filter-branch:*)",
      "Bash(dropdb:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)"
    ],

    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)",
      "Bash(systemctl restart:*)",
      "Bash(systemctl stop:*)",
      "Bash(systemctl disable:*)",
      "Bash(crontab -e:*)",
      "Bash(crontab -r:*)",
      "Bash(apt install:*)",
      "Bash(apt remove:*)",
      "Bash(apt-get install:*)",
      "Bash(apt-get remove:*)",
      "Bash(openssl genrsa:*)",
      "Bash(openssl req:*)"
    ],

    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(git reflog:*)",
      "Bash(git remote:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git blame:*)",
      "Bash(git stash list:*)",
      "Bash(git worktree list:*)",
      "Bash(git worktree add:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git config --get:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(cut:*)",
      "Bash(tr:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(jq:*)",
      "Bash(find:*)",
      "Bash(diff:*)",
      "Bash(stat:*)",
      "Bash(file:*)",
      "Bash(realpath:*)",
      "Bash(basename:*)",
      "Bash(dirname:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "Bash(test:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",

      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ln:*)",
      "Bash(touch:*)",
      "Bash(chmod:*)",
      "Bash(rm:*)",
      "Bash(zip:*)",
      "Bash(unzip:*)",
      "Bash(tar:*)",

      "Bash(./venv/bin/python:*)",
      "Bash(/opt/mp-analytics/venv/bin/python:*)",
      "Bash(python3:*)",
      "Bash(./venv/bin/pip install:*)",
      "Bash(./venv/bin/pip list:*)",
      "Bash(python3 -m unittest:*)",
      "Bash(python3 tools/territory_guard.py:*)",
      "Bash(WORKSTREAM_OVERRIDE=1 ./venv/bin/python:*)",
      "Bash(PYTHONPATH=. ./venv/bin/python:*)",
      "Bash(PYTHONPATH=/opt/mp-analytics ./venv/bin/python:*)",
      "Bash(timeout:*)",

      "Bash(psql:*)",
      "Bash(docker ps:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(systemctl status:*)",
      "Bash(systemctl start:*)",
      "Bash(systemctl show:*)",
      "Bash(systemctl list-units:*)",
      "Bash(journalctl:*)",
      "Bash(ps:*)",
      "Bash(df:*)",
      "Bash(du:*)",
      "Bash(free:*)",
      "Bash(uptime:*)",
      "Bash(who:*)",
      "Bash(ip:*)",
      "Bash(tmux ls:*)",

      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(openssl s_client:*)",
      "Bash(openssl x509:*)",
      "Bash(dig:*)",
      "Bash(ping:*)",

      "Bash(cd:*)",
      "Bash(which:*)",
      "Bash(command -v:*)",
      "Bash(timedatectl:*)",
      "Bash(dmesg:*)",
      "Bash(nginx -t:*)",
      "Bash(crontab -l:*)",
      "Bash(apt list:*)",
      "Bash(tmux list-panes:*)",
      "Bash(tmux list-sessions:*)",
      "Bash(kill:*)",
      "Bash(pkill:*)",
      "Bash(nohup:*)",
      "Bash(install:*)",
      "Bash(claude mcp:*)",
      "Bash(pdftotext:*)",
      "Bash(identify:*)",
      "Bash(xxd:*)",

      "Read(./**)",
      "Read(//tmp/claude-0/**)",
      "Edit(./**)",
      "Write(./**)",

      "WebSearch",
      "WebFetch",
      "mcp__codex__codex",
      "mcp__codex__codex-reply",

      "Skill(update-config)",
      "Skill(code-review)",
      "Skill(simplify)",
      "Skill(claude-api)",
      "Skill(dataviz)",
      "Skill(artifact-design)",
      "Artifact"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Edit|Write|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 /opt/mp-analytics/tools/hooks/guard_side_effects.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
