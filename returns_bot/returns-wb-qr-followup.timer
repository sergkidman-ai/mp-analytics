[Unit]
Description=Retry late WB QR: weekdays from 10:15, Saturday from 14:15 MSK

[Timer]
# Server UTC: 07:15 = 10:15 Moscow; existing full-report users wait until 14:15.
OnCalendar=Mon..Fri *-*-* 07..20:15:00
OnCalendar=Sat *-*-* 11..20:15:00
Persistent=true
Unit=returns-wb-qr-followup.service

[Install]
WantedBy=timers.target
