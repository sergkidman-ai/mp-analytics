[Unit]
Description=Returns bot (Telegram) — возвраты FBS Ozon/Yandex/WB
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mp-analytics
ExecStart=/opt/mp-analytics/venv/bin/python -m returns_bot.bot
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
