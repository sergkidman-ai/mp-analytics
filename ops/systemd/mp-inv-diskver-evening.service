[Unit]
Description=Sber Diskver unsigned prepayments at 17:00 MSK
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/mp-analytics/venv/bin/python /opt/mp-analytics/ops/diskver_bank_schedule.py evening
TimeoutStartSec=25min
