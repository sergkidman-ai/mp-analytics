[Unit]
Description=Alfa Cifrovoy Kvadrat morning
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
Environment=PYTHONUNBUFFERED=1
UMask=0077
ExecStart=/opt/mp-analytics/venv/bin/python /opt/mp-analytics/ops/diskver_bank_schedule.py morning --bank alfa
TimeoutStartSec=25min
