[Unit]
Description=Supplier invoices and UPD from IMAP to MoySklad
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mp-analytics
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mp-analytics/venv/bin/python /opt/mp-analytics/invoice_bot/mail_poller.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
