[Unit]
Description=Weekly marketplace charge and service watch for Natalia
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
# Raw finance data is refreshed by mp-reports-refresh twice daily.
ExecStart=/opt/mp-analytics/venv/bin/python -m ops.fin_charge_watch --send
TimeoutStartSec=20min
Nice=10
StandardOutput=journal
StandardError=journal
