# поток: infra
[Unit]
Description=Encrypted Pult PostgreSQL and deployment backup with isolated restore verification
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/mp-analytics
ExecStart=/opt/mp-analytics/venv/bin/python -B /opt/mp-analytics/ops/pult_backup.py once
TimeoutStartSec=3h
Nice=15
IOSchedulingClass=best-effort
IOSchedulingPriority=7
CPUQuota=100%
MemoryHigh=1G
MemoryMax=2G
PrivateTmp=true
