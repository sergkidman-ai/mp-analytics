[Unit]
Description=Ozon card problem detector
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
UMask=0077
StandardOutput=append:/opt/mp-analytics/card_health.log
StandardError=append:/opt/mp-analytics/card_health.log
ExecStart=/opt/mp-analytics/venv/bin/python -u -m tools.ozon_card_daily --scan-only
TimeoutStartSec=1800
