[Unit]
Description=Nightly full 90-day MS transit reconciliation (FBS and FBO)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
EnvironmentFile=/opt/mp-analytics/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mp-analytics/venv/bin/python -m ops.ms_market_status_live --mode night --apply
TimeoutStartSec=19800
UMask=0077
Nice=15
NoNewPrivileges=true
PrivateTmp=true
