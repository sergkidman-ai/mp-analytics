# поток: mkt
[Unit]
Description=WB CPC advertising budget monitor (read-only, local report)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
ExecStart=/usr/bin/flock -n /run/lock/mp-wb-ad-budget-guard.lock /opt/mp-analytics/venv/bin/python -m ops.wb_ad_budget_guard --dry
TimeoutStartSec=5min
UMask=0027
