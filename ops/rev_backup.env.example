# поток: rev
# Copy to /root/.config/rev-recovery/backup.env, chmod 600.
REV_BACKUP_DIR=/root/rev-recovery/backups
REV_BACKUP_PASSPHRASE_FILE=/root/.config/rev-recovery/backup.key
REV_BACKUP_KEEP_RECENT=12
REV_BACKUP_KEEP_DAYS=7
# Select exactly one existing external destination; never this VPS/public GitHub.
# REV_BACKUP_OFFSITE_METHOD=ssh
# REV_BACKUP_SSH_HOST=
# REV_BACKUP_SSH_PORT=22
# REV_BACKUP_SSH_USER=
# REV_BACKUP_SSH_DIR=/private/rev-backups
# REV_BACKUP_SSH_KEY=/root/.config/rev-recovery/offsite_ed25519
# REV_BACKUP_SSH_KNOWN_HOSTS=/root/.config/rev-recovery/known_hosts
# Or existing private Google Drive folder + offline OAuth credentials:
# REV_BACKUP_OFFSITE_METHOD=gdrive
# REV_BACKUP_DRIVE_FOLDER_ID=
# REV_BACKUP_DRIVE_AUTH_FILE=/root/.config/rev-recovery/drive-oauth.json
# OAuth JSON keys: client_id, client_secret, refresh_token. Never commit it.
