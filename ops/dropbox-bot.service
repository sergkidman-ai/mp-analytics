[Unit]
Description=Private Telegram dropbox for incoming files and notes
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mp-analytics
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/mp-analytics/venv/bin/python /opt/mp-analytics/dropbox_bot/dropbox_bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
