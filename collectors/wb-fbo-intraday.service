# поток: fin
[Unit]
Description=Pult WB acc1 FBO intraday stock observations
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics/runtime/wb-fbo-intraday-current
ExecStart=/opt/mp-analytics/venv/bin/python -m collectors.wb_fbo_intraday
TimeoutStartSec=300
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
