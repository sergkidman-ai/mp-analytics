# поток: fin
[Unit]
Description=Track FBS return origins and verify FBO cost from original shipment evidence
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics
ExecStart=/opt/mp-analytics/venv/bin/python -u -m collectors.fbo_traceability --proof-limit 50
TimeoutStartSec=240
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/mp-analytics/runtime/ms_api_control
