[Unit]
Description=Rev moderation on cloud-001 (publication fenced)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/mp-analytics/.claude/worktrees/rev-recovery-20261103
ExecStart=/opt/mp-analytics/venv/bin/python -u feedback_bot/tg_moderation.py
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
