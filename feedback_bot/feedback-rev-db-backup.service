# поток: rev
[Unit]
Description=Consistent Rev database and source snapshot without reproducible venv
ConditionPathExists=/root/.config/rev-recovery/db-backup-enabled
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
WorkingDirectory=/opt/mp-analytics/.claude/worktrees/rev-recovery-20261103
ExecStart=/opt/mp-analytics/venv/bin/python ops/rev_backup.py --database-only --config /root/.config/rev-recovery/db-backup.env
TimeoutStartSec=30min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
