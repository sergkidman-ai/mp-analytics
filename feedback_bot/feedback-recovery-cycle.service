[Unit]
Description=Rev collection, drafts and moderation cycle
After=network-online.target postgresql.service feedback-moderation.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics/.claude/worktrees/rev-recovery-20261103
ExecStart=/usr/bin/flock -n -E 75 /root/rev-recovery/collection.lock /opt/mp-analytics/venv/bin/python -u feedback_bot/recovery_cycle.py
SuccessExitStatus=75
TimeoutStartSec=90min
UMask=0077
Environment=PYTHONUNBUFFERED=1
StandardOutput=journal
StandardError=journal
