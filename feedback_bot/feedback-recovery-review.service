[Unit]
Description=Rev Batch results and existing-card updates
After=network-online.target postgresql.service feedback-moderation.service

[Service]
Type=oneshot
WorkingDirectory=/opt/mp-analytics/.claude/worktrees/rev-recovery-20261103
ExecStart=/usr/bin/flock -n -E 75 /root/rev-recovery/cycle.lock /opt/mp-analytics/venv/bin/python -u feedback_bot/recovery_review_cycle.py
SuccessExitStatus=75
TimeoutStartSec=20min
UMask=0077
StandardOutput=journal
StandardError=journal
