# --- секреты: НИКОГДА не в git ---
# .env и любые его варианты/бэкапы (.env.bak_*, .env.prod, .env.local ...),
# кроме шаблона без значений
.env
.env.*
!.env.example
*.env.bak
*.env.bak.*
env.bak_*

# учётки Claude Code и их бэкапы
.claude/.credentials.json
.claude/.credentials.json.*
.claude/settings.local.json

# приватные ключи, сертификаты, хранилища ключей — в любом месте дерева
*.key
*.pem
*.p12
*.pfx
*.jks
*.keystore

# рантайм-логи (в т.ч. журнал guard_side_effects)
logs/

__pycache__/
*.pyc
venv/
*.log
pgdata/
incoming/
.workstream
.claude/worktrees/
docs/feedback_drafts.html
docs/feedback_reference.html
docs/feedback_compare.html
docs/feedback_variability.html
feedback_run.html
feedback_run_artifact.html
docs/feedback_*.html
docs/questions_*.html

# Отчёты МП — runtime state (не коммитим)
reports/data/.ms_catalog_last_sync
reports/data/.mp_ozon_hist.lock
reports/data/backups/
reports/data/wb_reconcile_log.jsonl
reports/data/.*.lock

# Аналитические выгрузки docs/*.csv — одноразовый аудит-мусор, не коммитим.
# Уже отслеживаемые нужные файлы оставлены явными исключениями ниже.
docs/*.csv
!docs/ms_zero_cogs_demands.csv
!docs/ozon_dims_overpay.csv
!docs/wb_logistics_overpay.csv
!docs/wb_price_change_unit_econ.csv

# Разовые аналитические скрипты и их выгрузки — не в git
scratch_*.py
scratchpad_*.json
reports/ms-recon.*
# Выхлопы обслуживающих инструментов (tools/) — рантайм
tools/*.out
tools/purge_trash_log.jsonl

# Ежедневные выгрузки контроля маржи (регенерируются прогоном, не коммитим)
reports/data/margin_control_*.csv
reports/data/margin_control_*.txt
reports/data/tc_best_raw_*.json

# банковские сертификаты (Alfa H2H и пр.) — секреты, НИКОГДА не коммитим
secrets/

# личный ящик dropbox-bot (входящие файлы/скриншоты) — не в git
/dropbox/

# deploy-worktree, из которого крон запускает поток inv (см. run_inv.py)
.deploy/

# prc: отчёты прогонов прайсов пересобираются каждой загрузкой
docs/prc/
tools/our_nm.txt
tools/serp_*.csv
tools/serp_raw_sample.json
tools/*_summary.csv
tools/*_detail.csv

# канонический стор знания — отдельный репозиторий /opt/mp-knowledge
.kb
bin/mpsess.local
