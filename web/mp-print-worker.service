# поток: print
[Unit]
Description=mp-analytics warehouse print queue
After=network.target docker.service

[Service]
WorkingDirectory=/opt/mp-analytics
ExecStart=/opt/mp-analytics/venv/bin/python -B -m print_service.worker
Environment=PRINT_SCHEMA=print_ops
Environment=PRINT_DATA_ROOT=/opt/mp-analytics/.private/print_runtime
# Default test guard. Change only after approval of live MS exports.
Environment=PRINT_EXPORT_UNPRINTED=0
UMask=0077
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
